@* 1枚のカード。手札・場の両方で使う。モンスターは星とATK/DEF、魔法・罠は種類と効果を表示する。 *@
<div class="card-view @CssClass" @onclick="HandleClick" title="@Tooltip">
    @if (Hidden)
    {
        <div class="card-back"></div>
    }
    else
    {
        <div class="card-name">@Card.Name</div>
        @if (IsMonster)
        {
            <div class="card-level">@(new string('★', Card.Level))</div>
            <div class="card-stats">
                <span>ATK @Card.Attack</span>
                <span>DEF @Card.Defense</span>
            </div>
        }
        else
        {
            <div class="card-kind">@KindText</div>
            <div class="card-text">@EffectText</div>
        }
        @if (Label is not null)
        {
            <div class="card-label">@Label</div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public required CardData Card { get; set; }

    /// <summary>裏向きで表示する(相手のセットカードなど)。</summary>
    [Parameter] public bool Hidden { get; set; }

    /// <summary>守備表示(横向き)で表示する。</summary>
    [Parameter] public bool Defense { get; set; }

    [Parameter] public bool Selected { get; set; }

    /// <summary>実況中の行動に関わるカードとして強調表示する。</summary>
    [Parameter] public bool Highlighted { get; set; }

    [Parameter] public bool Clickable { get; set; }

    /// <summary>カード下部に出す補足(自分のセットカードの「セット中」など)。</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }

    private bool IsMonster => Card.Kind is CardKind.NormalMonster or CardKind.EffectMonster;

    private string KindText => Card.Kind == CardKind.Trap ? "【罠】" : "【魔法】";

    private string EffectText => Card.Effect is null ? "" : CardEffectText.Describe(Card.Effect);

    private string CssClass => string.Join(' ', new[]
    {
        Card.Kind switch { CardKind.Spell => "spell", CardKind.Trap => "trap", _ => null },
        Defense ? "defense" : null,
        Selected ? "selected" : null,
        Highlighted ? "highlighted" : null,
        Clickable ? "clickable" : null,
    }.Where(c => c is not null));

    private string? Tooltip => Hidden ? null
        : IsMonster ? $"{Card.Name} Lv{Card.Level} ATK {Card.Attack} / DEF {Card.Defense}"
        : $"{Card.Name} {KindText}{EffectText}";

    private async Task HandleClick()
    {
        if (Clickable)
        {
            await OnClick.InvokeAsync();
        }
    }
}
