@page "/"
@implements IDisposable
@inject DuelViewModel Vm

<PageTitle>カードゲーム</PageTitle>

<div class="duel">
    <section class="board">
        <PlayerStatusView Player="Vm.Cpu"
                          IsCurrent="Vm.Duel.CurrentPlayer == Vm.Cpu"
                          ShowHandCount="true"
                          LifeChange="Vm.LifeChangeOf(Vm.Cpu)" />

        <SpellTrapZoneView Slots="Vm.Cpu.SpellTrapSlots" IsOpponentField="true" />

        <FieldView Slots="Vm.Cpu.MonsterSlots"
                   IsOpponentField="true"
                   Highlighted="Vm.HighlightedMonsters"
                   IsClickable="Vm.IsMonsterClickable"
                   OnMonsterClick="Vm.ClickMonsterAsync" />

        <CommentaryView Commentary="Vm.Commentary" />

        @if (Vm.ResponsePrompt is { } prompt)
        {
            <ResponsePromptView Prompt="prompt"
                                Traps="Vm.RespondableTraps"
                                OnActivate="Vm.RespondWithTrap"
                                OnPass="Vm.PassResponse" />
        }

        <FieldView Slots="Vm.Human.MonsterSlots"
                   Selected="Vm.SelectedAttacker"
                   Tributes="Vm.PendingTributes"
                   Highlighted="Vm.HighlightedMonsters"
                   IsClickable="Vm.IsMonsterClickable"
                   OnMonsterClick="Vm.ClickMonsterAsync"
                   IsEmptySlotClickable="Vm.CanPlaceInMonsterSlot"
                   OnEmptySlotClick="Vm.PlaceInMonsterSlotAsync"
                   PositionChangeLabel="Vm.PositionChangeLabelFor"
                   OnChangePosition="Vm.ChangePositionAsync" />

        <SpellTrapZoneView Slots="Vm.Human.SpellTrapSlots"
                           IsCardClickable="Vm.CanActivateSetCard"
                           OnCardClick="Vm.ActivateSetCard"
                           IsEmptySlotClickable="Vm.CanPlaceInSpellTrapSlot"
                           OnEmptySlotClick="Vm.PlaceInSpellTrapSlot" />

        <HandView Cards="Vm.Human.Hand"
                  CanDo="Vm.CanDoHandAction"
                  Pending="Vm.PendingPlacement"
                  SelectedIndex="Vm.SelectedHandIndex"
                  OnAction="Vm.BeginHandActionAsync" />

        <PlayerStatusView Player="Vm.Human"
                          IsCurrent="Vm.Duel.CurrentPlayer == Vm.Human"
                          LifeChange="Vm.LifeChangeOf(Vm.Human)" />
    </section>

    <aside class="side">
        <div class="turn">ターン @Vm.Duel.TurnCount</div>
        <ol class="phases">
            @foreach (var phase in PhaseNames.All)
            {
                <li class="@(phase == Vm.Duel.CurrentPhase ? "active" : null)" @key="phase">
                    @PhaseNames.ToDisplayName(phase)
                </li>
            }
        </ol>

        @if (Vm.Duel.IsFinished && !Vm.IsCpuPlaying)
        {
            <div class="result">@(Vm.Duel.Winner == Vm.Human ? "あなたの勝利!" : "あなたの敗北…")</div>
            <button class="btn btn-primary w-100" @onclick="Vm.StartNewDuel">新しい対戦を始める</button>
        }
        else if (Vm.IsCpuPlaying)
        {
            <div class="controls">
                <button class="btn btn-outline-secondary" @onclick="Vm.SkipCpuPlayback">スキップ</button>
            </div>
        }
        else
        {
            <div class="controls">
                @if (Vm.HasPendingOperation || Vm.SelectedAttacker is not null)
                {
                    <button class="btn btn-outline-secondary" @onclick="Vm.CancelSelection">選択をやめる</button>
                }
                @if (Vm.CanGoToBattle)
                {
                    <button class="btn btn-danger" @onclick="Vm.GoToNextPhase">バトルフェーズへ</button>
                }
                @if (Vm.CanGoToMain2)
                {
                    <button class="btn btn-outline-secondary" @onclick="Vm.GoToNextPhase">メインフェーズ2へ</button>
                }
                @if (Vm.CanDirectAttack)
                {
                    <button class="btn btn-warning" @onclick="Vm.DirectAttackAsync">ダイレクトアタック</button>
                }
                <button class="btn btn-dark" disabled="@(!Vm.IsHumanTurn)" @onclick="Vm.EndTurnAsync">ターン終了</button>
            </div>

            @if (!string.IsNullOrEmpty(Vm.Hint))
            {
                <div class="hint">@Vm.Hint</div>
            }
        }

        @if (Vm.ErrorMessage is not null)
        {
            <div class="alert alert-warning py-1 my-2">@Vm.ErrorMessage</div>
        }

        <h6 class="mt-3">ログ</h6>
        <DuelLogView Entries="Vm.Duel.Log" />
    </aside>
</div>

@code {
    protected override void OnInitialized()
    {
        Vm.OnChange += HandleChange;
    }

    // CPU のターンの再生中は、ボタン操作の処理が終わる前に途中経過を描画する必要がある
    private void HandleChange() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Vm.OnChange -= HandleChange;
    }
}
