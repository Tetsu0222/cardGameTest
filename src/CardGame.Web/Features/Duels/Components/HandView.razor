@* 自分の手札。モンスターには召喚・セット、魔法・罠には発動・セットのボタンを付ける。 *@
<div class="hand">
    @for (var i = 0; i < Cards.Count; i++)
    {
        var index = i;
        var card = Cards[index];
        var isMonster = card.Kind is CardKind.NormalMonster or CardKind.EffectMonster;
        var primary = new HandAction(index, isMonster ? HandActionKind.Summon : HandActionKind.ActivateSpell);
        var secondary = new HandAction(index, isMonster ? HandActionKind.SetMonster : HandActionKind.SetSpellTrap);
        <div class="hand-card" @key="index">
            <CardView Card="card" Selected="SelectedIndex == index" />
            <div class="hand-actions">
                <button class="btn btn-sm @(Pending == primary ? "btn-warning" : "btn-primary")"
                        disabled="@(!CanDo(primary))"
                        @onclick="() => OnAction.InvokeAsync(primary)">
                    @(isMonster ? "召喚" : "発動")
                </button>
                <button class="btn btn-sm @(Pending == secondary ? "btn-warning" : "btn-secondary")"
                        disabled="@(!CanDo(secondary))"
                        @onclick="() => OnAction.InvokeAsync(secondary)">
                    セット
                </button>
            </div>
        </div>
    }
    @if (Cards.Count == 0)
    {
        <div class="hand-empty">手札がありません</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<CardData> Cards { get; set; }
    [Parameter, EditorRequired] public required Func<HandAction, bool> CanDo { get; set; }

    /// <summary>マスの選択待ちになっている操作(ボタンを強調表示する)。</summary>
    [Parameter] public HandAction? Pending { get; set; }

    /// <summary>操作の途中で選択中のカードの位置(カードを強調表示する)。</summary>
    [Parameter] public int? SelectedIndex { get; set; }

    [Parameter] public EventCallback<HandAction> OnAction { get; set; }
}
