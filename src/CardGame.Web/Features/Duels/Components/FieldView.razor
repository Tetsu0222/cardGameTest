@* 1人分のモンスターゾーン(5マス)。マスの位置は固定で、モンスターが場を離れても他のモンスターは動かない。 *@
<div class="field">
    @for (var i = 0; i < Slots.Count; i++)
    {
        var monster = Slots[i];
        <div class="slot" @key="i">
            @if (monster is null)
            {
                var slotIndex = i;
                var clickable = IsEmptySlotClickable?.Invoke(slotIndex) ?? false;
                <div class="empty @(clickable ? "clickable" : null)"
                     @onclick="() => HandleEmptySlotClick(slotIndex, clickable)"></div>
            }
            else
            {
                <CardView Card="monster.Card"
                          Hidden="IsOpponentField && monster.Position == BattlePosition.FaceDownDefense"
                          Defense="monster.Position != BattlePosition.FaceUpAttack"
                          Label="LabelFor(monster)"
                          Selected="monster == Selected"
                          Highlighted="Highlighted?.Contains(monster) ?? false"
                          Clickable="IsClickable?.Invoke(monster) ?? false"
                          OnClick="() => OnMonsterClick.InvokeAsync(monster)" />
            }
        </div>
    }
</div>

@code {
    /// <summary>モンスターゾーンのマス(左から順)。空きマスは null。</summary>
    [Parameter, EditorRequired] public required IReadOnlyList<FieldMonster?> Slots { get; set; }

    /// <summary>相手の場か。相手の裏側モンスターは中身を隠す。</summary>
    [Parameter] public bool IsOpponentField { get; set; }

    [Parameter] public FieldMonster? Selected { get; set; }

    /// <summary>実況中の行動に関わるモンスター(強調表示する)。</summary>
    [Parameter] public IReadOnlyCollection<FieldMonster>? Highlighted { get; set; }

    [Parameter] public Func<FieldMonster, bool>? IsClickable { get; set; }
    [Parameter] public EventCallback<FieldMonster> OnMonsterClick { get; set; }

    /// <summary>空きマスを選べるか(召喚先の選択中など)。引数はマスの位置。</summary>
    [Parameter] public Func<int, bool>? IsEmptySlotClickable { get; set; }

    [Parameter] public EventCallback<int> OnEmptySlotClick { get; set; }

    private async Task HandleEmptySlotClick(int slotIndex, bool clickable)
    {
        if (clickable)
        {
            await OnEmptySlotClick.InvokeAsync(slotIndex);
        }
    }

    private string? LabelFor(FieldMonster monster) =>
        !IsOpponentField && monster.Position == BattlePosition.FaceDownDefense ? "セット中" :
        !IsOpponentField && monster.HasAttacked ? "攻撃済み" :
        null;
}
