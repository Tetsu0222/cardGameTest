@* カード一覧。各カードに、デッキに入れている枚数と、増やす・減らすボタンを付ける。 *@
<div class="pool-grid">
    @foreach (var card in Cards)
    {
        var count = CountOf(card);
        <div class="pool-item @(count > 0 ? "in-deck" : null)" @key="card.Id">
            <CardView Card="card"
                      Label="@(ValidateCustomCard.IsCustomCardId(card.Id) ? "自作" : null)"
                      Clickable="CanAdd(card)"
                      OnClick="() => OnAdd.InvokeAsync(card)" />
            <div class="pool-actions">
                <button class="btn btn-sm btn-outline-light" disabled="@(!CanRemove(card))" @onclick="() => OnRemove.InvokeAsync(card)">−</button>
                <span class="pool-count">@count / @MaxCopies</span>
                <button class="btn btn-sm btn-light" disabled="@(!CanAdd(card))" @onclick="() => OnAdd.InvokeAsync(card)">+</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<CardData> Cards { get; set; }
    [Parameter, EditorRequired] public required Func<CardData, int> CountOf { get; set; }
    [Parameter, EditorRequired] public required Func<CardData, bool> CanAdd { get; set; }
    [Parameter, EditorRequired] public required Func<CardData, bool> CanRemove { get; set; }

    /// <summary>同じカードを入れられる最大枚数(表示用)。</summary>
    [Parameter] public int MaxCopies { get; set; }

    [Parameter] public EventCallback<CardData> OnAdd { get; set; }
    [Parameter] public EventCallback<CardData> OnRemove { get; set; }
}
